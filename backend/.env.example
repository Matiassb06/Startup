# ─── Database ───
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost/traintohire

# ─── JWT ───
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ─── CORS ───
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Email (dejar vacío SMTP_HOST para modo consola/desarrollo) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@traintohire.com
FRONTEND_URL=http://localhost:5173
